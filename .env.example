# Azure Speech F0 credentials for tools/build-audio.js
# Copy this file to `.env` and fill in the values below.
# F0 is the free tier — check https://azure.microsoft.com/pricing/details/cognitive-services/speech-services/

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=en-US-JennyNeural
AZURE_SPEECH_FORMAT=audio-24khz-48kbitrate-mono-mp3

# Tencent Cloud TTS credentials for tools/build-audio-tencent.mjs
# Sign up at https://console.cloud.tencent.com/tts and create a CAM
# API key (SecretId + SecretKey). The AppId is the numeric account id
# shown in the top-right of the console.
# VoiceType 1004 = 智童 (女童声) — child voice, the default for kids.
# Other kid-friendly picks: 101006 智萌, 101007 智乖乖, 101008 智甜甜.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_APP_ID=
TENCENT_VOICE_TYPE=101016
TENCENT_CODEC=mp3
TENCENT_SAMPLE_RATE=16000
TENCENT_REGION=ap-guangzhou
